+	p->status = 1;
+	p->effects[BL_CAST(BL_PC,bl)->hatEffects.size()] = battle_config.autoattack_hateffect;
+
+	clif_send( p, p->packetLength, bl, AREA_AUTOATTACK_WOS);
+#endif
+}
